# TEMPLATE ONLY. setup-clean-env.sh creates private configuration and fresh secrets.
# Never copy the existing application's .env or existing data volumes.
RAG_CLEAN_CONFIG_VERSION=1
RAG_CLEAN_MODE=pilot
COMPOSE_PROJECT_NAME=
RAG_BIND_HOST=127.0.0.1
RAG_WEB_HOST_PORT=18573
WEB_ORIGIN=http://127.0.0.1:18573
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
AUTH_ENABLED=false
AUTH_ALLOW_UNAUTHENTICATED_PILOT=true
# Required external LLM: POST /v1/chat/completions (base may already end in /v1).
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
# Custom embedding protocol: POST /embed, inputs[], input_type=query|passage;
# JSON response is a list of vectors. This is NOT /v1/embeddings.
# Existing embedding clients do not send authentication headers; use a gateway if needed.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
# Direct Confluence. Server must be able to reach this HTTPS origin.
CONFLUENCE_BASE_URL=
CONFLUENCE_DEPLOYMENT=data_center
CONFLUENCE_AUTH_MODE=bearer
CONFLUENCE_ALLOWED_SPACES=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_ACCESS_TOKEN=
# OIDC mode: setup --mode oidc; external entry point must be HTTPS.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_ALGORITHM=RS256
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
