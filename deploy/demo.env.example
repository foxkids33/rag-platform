# Template only; setup-demo-env.sh creates private .env.demo credentials.
APP_ENV=server
APP_NAME=Скала^р RAG
AUTH_ENABLED=false
AUTH_ALLOW_UNAUTHENTICATED_PILOT=true
AUTH_LOCAL_SUBJECT=local-user
AUTH_LOCAL_TENANT=local
AUTH_ADMIN_ROLE=rag-admin
WEB_ORIGIN=http://192.0.2.122:15173
DEMO_BIND_HOST=192.0.2.122
DEMO_WEB_PORT=15173
DEMO_GPU_IMAGE=vllm/vllm-openai:v0.30.0
DEMO_GPU_DEVICE_ID=0
DEMO_POSTGRES_PASSWORD=REPLACE_POSTGRES_SECRET
DEMO_MINIO_PASSWORD=REPLACE_MINIO_SECRET
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
EMBEDDING_BASE_URL=http://embedding:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_NATIVE_DIM=1024
EMBEDDING_CONTEXT_TOKENS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_SCHEMA_INITIALIZATION_ALLOWED=true
RERANK_ENABLED=false
VLLM_BASE_URL=http://192.0.2.122:18437
VLLM_MODEL=corporate-llm
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.1
RAG_CONTEXT_MAX_CHARS=18000
RAG_SOURCE_MAX_CHARS=3000
RAG_SOURCE_LIMIT=6
CONFLUENCE_ENABLED=false
CONFLUENCE_BASE_URL=https://confluence.example.invalid
CONFLUENCE_CONNECTOR_ENABLED=true
LANGFUSE_ENABLED=false
