# App
APP_ENV=local
APP_NAME=RAG Platform
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL / pgvector
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# Redis
REDIS_URL=redis://redis:6379/0
INGESTION_QUEUE=rag:ingestion

# Object storage
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
UPLOAD_MAX_MB=100

# Internal model endpoints
VLLM_BASE_URL=http://vllm-host:8000
VLLM_API_KEY=
VLLM_MODEL=your-instruct-model
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.1
RAG_CONTEXT_MAX_CHARS=12000
RAG_SOURCE_MAX_CHARS=2200
RAG_SOURCE_LIMIT=5
RAG_HISTORY_MESSAGES=8
RAG_HISTORY_MAX_CHARS=8000
RAG_REWRITE_FOLLOWUPS=true
RAG_REWRITE_MAX_TOKENS=160
RAG_MIN_SOURCE_SCORE=0.05
RAG_RELATIVE_SOURCE_SCORE=0.25
RAG_SOURCE_SIMILARITY_THRESHOLD=0.78
RAG_MAX_SOURCES_PER_DOCUMENT=3
RAG_STRONG_EVIDENCE_SCORE=0.50
RAG_LIMITED_EVIDENCE_SCORE=0.15
EMBEDDING_BASE_URL=http://embedding:8080
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_NATIVE_DIM=384
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32
# Optional observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Document parsing and chunking
DOCLING_CHUNK_MAX_TOKENS=450
CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
PARENT_MAX_CHARS=12000
# Reranking
RERANK_BASE_URL=http://reranker:8081
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_ENABLED=true
RERANK_TIMEOUT_SECONDS=180
RERANK_CANDIDATE_LIMIT=20
RERANK_DOCUMENT_CHARS=1800
RERANK_RANK_WEIGHT=0.7
RERANK_RETRIEVAL_WEIGHT=0.3
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=8
RERANK_THREADS=4

