# No PAT, password, browser cookie or enrollment token belongs in this file.
# All paths below are examples: provision protected files before launching.
SERVER_CONNECTOR_RAG_URL=https://192.0.2.122:15173
SERVER_CONNECTOR_CONFLUENCE_URL=https://confluence.example.invalid
SERVER_CONNECTOR_ALLOWED_SPACES=KBR
SERVER_CONNECTOR_NETWORK=rag-zmostovoy_default

# Host state directory: owner 10001:10001, mode0700.
# credential.json inside: owner10001:10001, mode0600, enrolled to the exact RAG_URL.
SERVER_CONNECTOR_STATE_DIR=/home/intern/ZMostovoy/rag-platform/.storage/confluence-server/state
# A read-only PAT belonging to a dedicated corporate service account.
# Host file: owner10001:10001, mode0400 (or0600), never a personal token.
SERVER_CONNECTOR_PAT_FILE=/home/intern/ZMostovoy/rag-platform/.storage/confluence-server/secrets/service-pat

# Copy only public certificate/bundle files here, not private TLS keys.
SERVER_CONNECTOR_RAG_CA_FILE=/home/intern/ZMostovoy/rag-platform/.storage/confluence-server/certs/rag-ca.pem
# On some RPM-based hosts the system CA bundle is /etc/pki/tls/certs/ca-bundle.crt.
# Supply the correct corporate CA bundle; do not set VERIFY_SSL=false.
SERVER_CONNECTOR_CONFLUENCE_CA_FILE=/home/intern/ZMostovoy/rag-platform/.storage/confluence-server/certs/confluence-ca.pem
