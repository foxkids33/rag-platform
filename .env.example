# App
APP_ENV=local
APP_NAME=RAG Platform
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=8000
WEB_HOST_PORT=5173
EMBEDDING_HOST_PORT=8080

# Authentication. Keep disabled only for isolated local development.
AUTH_ENABLED=false
AUTH_ALLOW_UNAUTHENTICATED_PILOT=false
AUTH_LOCAL_SUBJECT=local-user
AUTH_LOCAL_TENANT=local
AUTH_ADMIN_ROLE=rag-admin
# Required when AUTH_ENABLED=true.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHM=RS256
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_JWKS_CACHE_SECONDS=300
OIDC_JWKS_TIMEOUT_SECONDS=5
OIDC_TOKEN_LEEWAY_SECONDS=30

# PostgreSQL / pgvector
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# Redis
REDIS_URL=redis://redis:6379/0
INGESTION_QUEUE=rag:ingestion
INGESTION_POLL_SECONDS=1
INGESTION_HEARTBEAT_SECONDS=15
INGESTION_STALE_AFTER_SECONDS=300
INGESTION_RECOVERY_INTERVAL_SECONDS=30
INGESTION_MAX_ATTEMPTS=3
OBJECT_DELETION_MAX_ATTEMPTS=10

# Object storage
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
UPLOAD_MAX_MB=100

# Direct Confluence access is retained for compatibility and offline operators.
# The release UI uses the outbound connector below, so no user token is sent to RAG.
CONFLUENCE_ENABLED=false
CONFLUENCE_DEPLOYMENT=cloud
CONFLUENCE_BASE_URL=https://example.atlassian.net
CONFLUENCE_AUTH_MODE=basic
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_ACCESS_TOKEN=
CONFLUENCE_TIMEOUT_SECONDS=30
CONFLUENCE_VERIFY_SSL=true
CONFLUENCE_ALLOW_INSECURE_HTTP=false
CONFLUENCE_MAX_PAGES_PER_IMPORT=500
CONFLUENCE_CONNECTOR_ENABLED=true
CONFLUENCE_CONNECTOR_ENROLLMENT_MINUTES=15
CONFLUENCE_CONNECTOR_OFFLINE_SECONDS=75
CONFLUENCE_CONNECTOR_LEASE_SECONDS=180
CONFLUENCE_CONNECTOR_JOB_TIMEOUT_SECONDS=300
CONFLUENCE_CONNECTOR_MAX_ATTEMPTS=3
CONFLUENCE_CONNECTOR_LONG_POLL_SECONDS=25
CONFLUENCE_CONNECTOR_MAX_PAGES_PER_JOB=50

# Internal model endpoints
VLLM_BASE_URL=http://vllm-host:8000
VLLM_API_KEY=
VLLM_MODEL=your-instruct-model
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.1
RAG_CONTEXT_MAX_CHARS=12000
RAG_SOURCE_MAX_CHARS=2200
RAG_SOURCE_LIMIT=5
RAG_HISTORY_MESSAGES=8
RAG_HISTORY_MAX_CHARS=8000
RAG_HISTORY_SUMMARY_CHARS=2400
RAG_REWRITE_FOLLOWUPS=true
RAG_REWRITE_MAX_TOKENS=160
RAG_MIN_SOURCE_SCORE=0.05
RAG_RELATIVE_SOURCE_SCORE=0.25
RAG_SOURCE_SIMILARITY_THRESHOLD=0.78
RAG_MAX_SOURCES_PER_DOCUMENT=3
RAG_QUERY_SELECTION_WEIGHT=0.30
RAG_ANSWER_CANDIDATE_LIMIT=20
RAG_STRONG_EVIDENCE_SCORE=0.50
RAG_LIMITED_EVIDENCE_SCORE=0.15
EMBEDDING_BASE_URL=http://embedding:8080
# Same-schema A/B candidate: intfloat/multilingual-e5-small (full reindex required).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_NATIVE_DIM=384
EMBEDDING_DIM=384
EMBEDDING_CONTEXT_TOKENS=512
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32
# Optional observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Document parsing and chunking
DOCLING_CHUNK_MAX_TOKENS=450
CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
PARENT_MAX_CHARS=12000
# Reranking
RERANK_BASE_URL=http://reranker:8081
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_ENABLED=false
RERANK_TIMEOUT_SECONDS=180
RERANK_CANDIDATE_LIMIT=20
RERANK_DOCUMENT_CHARS=1800
RERANK_RANK_WEIGHT=0.7
RERANK_RETRIEVAL_WEIGHT=0.3
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=8
RERANK_THREADS=4
