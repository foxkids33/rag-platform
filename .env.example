# App
APP_ENV=local
APP_NAME=RAG Platform
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL / pgvector
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# Redis
REDIS_URL=redis://redis:6379/0
INGESTION_QUEUE=rag:ingestion

# Object storage
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
UPLOAD_MAX_MB=100

# Internal model endpoints
VLLM_BASE_URL=http://host.docker.internal:8000
VLLM_API_KEY=
VLLM_MODEL=
EMBEDDING_BASE_URL=http://host.docker.internal:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://host.docker.internal:8081
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Document parsing and chunking
DOCLING_CHUNK_MAX_TOKENS=450
CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
PARENT_MAX_CHARS=12000
