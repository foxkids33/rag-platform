# Overrides for the isolated BGE-M3 A/B project. Keep the real file out of Git.
# Copy to deploy/bge-m3.env only after the read-only server inventory.
COMPOSE_PROJECT_NAME=rag-kbr-bge-ab

# Pin a PyTorch CUDA runtime compatible with the actual NVIDIA driver.
# Example format only; do not select it before inspecting the server:
BGE_PYTORCH_IMAGE=REPLACE_AFTER_GPU_INVENTORY
BGE_GPU_DEVICE_ID=REPLACE_AFTER_GPU_INVENTORY
# Use the same POSTGRES_USER/PASSWORD/DB as the base env, but ONLY host postgres.
# This resolves to the private PostgreSQL container of the A/B project.
# URL-encode special characters in the password.
BGE_DATABASE_URL=postgresql+asyncpg://rag:REPLACE_PASSWORD@postgres:5432/rag

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_NATIVE_DIM=1024
EMBEDDING_DIM=1024
EMBEDDING_CONTEXT_TOKENS=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_DEVICE=cuda:0
EMBEDDING_USE_FP16=true
RERANK_ENABLED=false
COMPOSE_PROFILES=
