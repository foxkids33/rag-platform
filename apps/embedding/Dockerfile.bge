ARG PYTORCH_IMAGE
FROM ${PYTORCH_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    TRANSFORMERS_CACHE=/models

WORKDIR /app

RUN python -m pip install --no-cache-dir \
    "FlagEmbedding==1.4.2" \
    "fastapi>=0.141,<0.142" \
    "numpy>=2.0,<3" \
    "pydantic-settings>=2.13,<3" \
    "uvicorn[standard]>=0.40,<1"

COPY app ./app

EXPOSE 8080
CMD ["python", "-m", "uvicorn", "app.bge_main:app", "--host", "0.0.0.0", "--port", "8080"]
