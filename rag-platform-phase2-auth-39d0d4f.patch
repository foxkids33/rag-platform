+router = APIRouter(prefix="/auth", tags=["authentication"])
+
+
+class PrincipalOut(BaseModel):
+    subject: str
+    tenant_id: str
+    roles: list[str]
+    auth_enabled: bool
+
+
+@router.get("/me", response_model=PrincipalOut)
+async def current_user(
+    principal: Principal = Depends(get_current_principal),
