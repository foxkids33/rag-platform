# Build the archived community server only from the official pinned source.
# No third-party MinIO binary or container mirror is used.
FROM golang:1.26-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS build
WORKDIR /source
RUN apk add --no-cache ca-certificates curl git
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
RUN curl --fail --location --retry 3 \
      https://codeload.github.com/minio/minio/tar.gz/7aac2a2c5b7c882e68c1ce017d8256be2feea27f \
      --output /tmp/minio-source.tar.gz \
    && echo "71794c2df26aad0cc99e8421c58b7aa2dd55969f979b0e7d1e931042e9fabcd6  /tmp/minio-source.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/minio-source.tar.gz --strip-components=1 \
    && rm /tmp/minio-source.tar.gz
RUN go build -mod=readonly -trimpath -p 2 \
      -ldflags="-s -w -X github.com/minio/minio/cmd.CommitID=7aac2a2c5b7c882e68c1ce017d8256be2feea27f -X github.com/minio/minio/cmd.Version=source-7aac2a2c5b7c" \
      -o /out/minio .

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS production-clean
RUN apk add --no-cache ca-certificates \
    && addgroup -g 10001 minio \
    && adduser -D -u 10001 -G minio minio \
    && mkdir -p /data /usr/share/licenses/minio \
    && chown 10001:10001 /data
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /source/LICENSE /source/NOTICE /source/CREDITS /usr/share/licenses/minio/
LABEL org.opencontainers.image.title="MinIO community source build for the local RAG pilot" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="7aac2a2c5b7c882e68c1ce017d8256be2feea27f" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENV MINIO_UPDATE=off HOME=/home/minio
WORKDIR /data
USER 10001:10001
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
